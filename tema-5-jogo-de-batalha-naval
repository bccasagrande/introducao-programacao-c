tema-5-jogo-de-batalha-naval/modulo_aventureiro.c
#include <stdio.h>

int main() {
    int tabuleiro[5][5];

    for(int i = 0; i < 5; i++) {
        for(int j = 0; j < 5; j++) {
            tabuleiro[i][j] = 0;
        }
    }

    printf("Tabuleiro preenchido\n");
    return 0;
}

